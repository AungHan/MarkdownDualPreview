{
  "name": "markdown-dual-preview",
  "displayName": "Markdown Dual Preview",
  "description": "Preview Markdown files side by side (up to three), each with an embedded section navigation pane.",
  "version": "0.4.0",
  "publisher": "aung-han",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AungHan/MarkdownDualPreview"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0C1826",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "markdown",
    "preview",
    "side by side",
    "table of contents",
    "scroll sync"
  ],
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownDualPreview.open",
        "title": "Open Dual Preview",
        "category": "Markdown Dual Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownDualPreview.exportHtml",
        "title": "Export to HTML",
        "category": "Markdown Dual Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownDualPreview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownDualPreview.open",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownDualPreview.exportHtml",
          "when": "editorLangId == markdown"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownDualPreview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@30"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Dual Preview",
      "properties": {
        "markdownDualPreview.maxPreviews": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "markdownDescription": "Maximum number of preview panels that can be open at the same time (1–3). Lowering this does not close previews that are already open."
        },
        "markdownDualPreview.maxContentWidth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Maximum width of the rendered content in pixels. Set to `0` for full width (no limit). A value like `900` constrains the text column for readability."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./src/webview/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "node esbuild.mjs && tsc -p ./test/integration/tsconfig.json",
    "test:integration": "node ./out-test/integration/runTests.js",
    "package": "npm run build:production && vsce package --no-dependencies"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.20.2",
    "jsdom": "^29.1.1",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
